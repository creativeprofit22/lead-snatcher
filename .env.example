# ===========================================
# Lead Snatcher Environment Configuration
# ===========================================
#
# EASY SETUP: Just run ./scripts/setup.sh
# It will generate this file with all secrets automatically!
#
# ===========================================

# Database (SQLite - no setup needed!)
DATABASE_URL="file:./data/lead-snatcher.db"

# ===========================================
# Required: Authentication & Security
# ===========================================
# These are auto-generated by ./scripts/setup.sh
# Or generate manually with: openssl rand -base64 32

NEXTAUTH_SECRET="generate-with-openssl-or-run-setup-script"
NEXTAUTH_URL="http://localhost:3000"

# Admin Secret - for creating users via /admin
ADMIN_SECRET="generate-with-openssl-or-run-setup-script"

# Encryption Secret - for API key storage
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET="generate-with-openssl-or-run-setup-script"

# Encryption Salt - must be separate from ENCRYPTION_SECRET
# Generate separately with: openssl rand -base64 16
# Keep both encryption values unchanged. Changing either makes stored API keys
# unreadable and requires users to re-enter their keys in Settings.
ENCRYPTION_SALT="generate-with-openssl-or-run-setup-script"

# ===========================================
# Optional: External API fallbacks
# User-saved keys in Settings take precedence.
# ===========================================

# RapidAPI (for Google Maps business search)
# Used when the current user has not saved a RapidAPI key.
# Get your key at: https://rapidapi.com/
# RAPIDAPI_KEY="your-rapidapi-key"

# Google PageSpeed Insights (for optional website performance analysis)
# Used when the current user has no readable saved PageSpeed API key.
# PAGESPEED_API_KEY="your-pagespeed-api-key"
